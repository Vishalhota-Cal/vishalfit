# Copy this file to .env and fill in your own values. .env is gitignored —
# nothing here ever leaves this machine, and none of it reaches the browser.
# On Vercel, set these same names as Project → Settings → Environment Variables
# instead of a .env file.

# Supabase project (Settings → API in your Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — it belongs on the
# server only. Never put it in index.html or any client-side code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket used for progress photos — create it once (Storage → New
# bucket → name it exactly this, and mark it Private).
SUPABASE_PHOTOS_BUCKET=progress-photos

# Stand-in for real auth until Supabase Auth ships (see README). Generate one
# UUID and use it forever — this is what all your data is stored under.
#   node -e "console.log(crypto.randomUUID())"
OWNER_USER_ID=

# The interim password gate in front of the whole app (middleware.js) — pick
# something only you know; this is what stands between the internet and your
# data until real accounts exist.
APP_PASSWORD=
# Random secret used to sign the login cookie. Generate once, keep stable:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=7417
